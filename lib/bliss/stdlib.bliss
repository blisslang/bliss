; Macros ;

(defmacro if [pred thenb elseb]
  (cond (pred thenb)
        (else elseb)))

(defmacro when [pred thenb]
  (cond (pred thenb)))

(defmacro unless [pred unlessb]
  (when (not pred) unlessb))

(defmacro set+ [var n] (set var (+ var n)))
(defmacro set- [var n] (set var (- var n)))
(defmacro set* [var n] (set var (* var n)))
(defmacro set/ [var n] (set var (/ var n)))

; Collections ;

;(def cswap [lst i1 i2]
  (let temp (cget lst i1))
  (cset lst i1 (cget lst i2))
  (cset lst i2 temp));