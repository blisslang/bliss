(defmod Core
  (defmod IO
    (def puts [str]
      (print-string str))

    (def putln [x]
      (print-endline x)))

  (defmod Math
    (def fib [n]
      (cond ((<= n 1) n)
            (else (+ (fib (- n 1)) (fib (- n 2))))))))

(use Core)

(def main
  (let res (Math/fib 8))
  (IO/puts "Fib result: ")
  (IO/putln res))