(defmacro if [pred thenb elseb]
  (cond (pred thenb)
        (else elseb)))

(defmacro when [pred &exprs]
  (cond (pred &exprs)))

(defmacro unless [pred &exprs]
  (when (not pred) &exprs))

(def IO/puts [str]
  (print-string str))

(def IO/putln [x]
  (print-endline x))

(def Math/fib [n]
  (if (<= n 1)
      n
      (+ (Math/fib (- n 1)) (Math/fib (- n 2)))))

(def main
  (let res (Math/fib 8))
  (IO/puts "Fib result: ")
  (IO/putln res))