(defmod Core
  ; Macros (hoisted) ;
  (defmacro if [pred thenb elseb]
    (cond (pred thenb)
          (else elseb)))

  (defmacro when [pred &exprs]
    (cond (pred &exprs)))

  (defmacro unless [pred &exprs]
    (when (not pred) &exprs))

  (defmod IO
    (def puts [str]
      (print-string str))

    (def putln [x]
      (print-endline x)))

  (defmod Math
    (def fib [n]
      (if (<= n 1)
          n
          (+ (fib (- n 1)) (fib (- n 2)))))))

(use Core)

(def main
  (let res (Math/fib 8))
  (IO/puts "Fib result: ")
  (IO/putln res))